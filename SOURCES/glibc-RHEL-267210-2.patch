Downstream-only patch to adjust tst-origin-secure to use SGID instead of
the glibc.rtld.enable_secure tunable that is unavailable here.

The test will still be reported as UNSUPPORTED during a check run since
test-container does not support multiple groups, but it can be run as
root like this: "./testrun.sh elf/tst-origin-secure", for verification
from inside the build tree (un-containerized).  The test will fail
when the installed glibc version is vulnerable.

Note: Running outside test-container as root installs objects at
/usr/lib64/tst-origin-secure/ and /tmp/tst-origin-secure, which should
both be cleaned up afterward.

diff --git a/elf/tst-origin-secure.c b/elf/tst-origin-secure.c
index f304823b498cc140..2ef4f93a3785da15 100644
--- a/elf/tst-origin-secure.c
+++ b/elf/tst-origin-secure.c
@@ -55,6 +55,7 @@
 
 #include <stdio.h>
 #include <stdlib.h>
+#include <sys/stat.h>
 #include <unistd.h>
 #include <sys/wait.h>
 
@@ -159,8 +160,11 @@ do_test (void)
      trusted SLIBDIR/SUBDIR and loads the trusted copy; a loader with the bug
      opens the raw path, resolves "sub", and loads the attacker copy.  */
   {
-    char *const env[] = { (char *) "GLIBC_TUNABLES=glibc.rtld.enable_secure=1",
-			  NULL };
+    /* Make the victim setgid to force AT_SECURE.  */
+    if (chown (BASE "/a/b/victim", -1, getgid () + 1) != 0
+	|| chmod (BASE "/a/b/victim", 02755) != 0)
+      FAIL_UNSUPPORTED ("cannot make victim SGID: %m");
+    char *const env[] = { NULL };
     int rc = run_victim (env);
     switch (rc)
       {
